:Namespace Utils
    ⍝ Convert character vector/array of digits ('123') to integers (1 2 3)
    toDigits ← {¯48 + ⎕UCS ⍵}
    
    ⍝ Read all lines from a text file
    readLines ← {⊃⎕NGET ⍵ 1}

    ⍝ read the first line from a text file, usually for single line inputs
    readSingleLine ← {⊃⊃ ⎕NGET ⍵ 1}

    ⍝ parses a single line of numbers using the space and any delimeters in the left argument
    ⍝ errors if not all numbers sare parsed
    parseNumbers ← {
        ⍺ ← ' '
        (valid nums) ← ⍺ ⎕VFI ('-' ⎕R '¯') ⍵
        ~∧/valid: 'parseNumbers: invalid token' ⎕SIGNAL 11
        nums
    }
    ⍝ parse a single number
    parseNumber ← {
        (valid nums) ← ⎕VFI ('-' ⎕R '¯') ⍵
        (,1)≢valid : 'parseInt: expected a single valid number' ⎕SIGNAL 11
        ⊃nums
    }
    ⍝ parse a vector of number strings
    parseNumbersVector ← {
        (valid nums) ← ⎕VFI ('-' ⎕R '¯') ∊' ',¨ ⍵
        ~∧/valid ∨ (≢⍵)≠≢nums: 'parseNumbersVector: invalid token' ⎕SIGNAL 11
        nums
    }

    readSingleNumber ← parseNumber readSingleLine

    partitionBySpace ← ' '∘(≠⊆⊢)
    partitionByCharacter ← (≠⊆⊢)
    partitionByCharacters ← (~⍤∊⍨⊆⊢)

:EndNamespace
